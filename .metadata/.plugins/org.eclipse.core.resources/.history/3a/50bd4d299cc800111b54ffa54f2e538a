package com.methodOrFunction;

public class EvenOrOdd 
{
  public static void main(String[] args) 
  {
	 evenOdd(123);
  }
  
  public static void evenOdd(int num)
  {
	  if (num%2 ==0)
	  {
		  System.out.println("Number is even");
	  }
	  else
	  {
		  System.out.println("Number is odd");
	  }
  }
}
