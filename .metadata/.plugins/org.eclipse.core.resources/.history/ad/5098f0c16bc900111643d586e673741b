package com.methodOrFunction.returntype.program;

public class PerfectNumber 
{
	public static void perfectNum(int num)
	{
		int sum =0;
		for(int i=1; i<num; i++)
		{
			if(num%i==0)
			{
			   sum+=i;	
			}
		}
		boolean nu = sum == num;
		System.out.println(nu);
	}
	
	
	public static void main(String[] args) 
	{
		perfectNum(8);
	}

}
